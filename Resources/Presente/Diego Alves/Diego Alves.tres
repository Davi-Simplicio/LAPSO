[sub_resource type="Resource" id="Resource_4aidh"]
script = ExtResource("2_ifu34")
lines = Array[String](["Diego Alves: Cara, eu não aguento mais o síndico. Eu tenho uma rotina sagrada: meu alarme toca no meio-dia em ponto para eu pausar o trabalho. Eu levo exatamente meia hora para fritar meus ovos e esquentar o arroz. E adivinha? É sempre nesse exato minuto, quando vou dar a primeira garfada, que o morador de cima começa a arrastar os móveis e o encanamento do prédio começa a estalar! Dá para acertar o relógio pelo barulho."])
metadata/_custom_type_script = "uid://bu5dk5m3o7xlm"

