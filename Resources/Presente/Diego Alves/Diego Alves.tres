script = ExtResource("2_ifu34")
lines = Array[String](["José: Olá", "Diego Alves: Você viu? O vizinho do 7 sumiu. Outro cientista doido. O cara vivia me pedindo pra levar umas peças eletrônicas esquisitas. Ele dizia que precisava de um 'fluxo de energia limpo' pra um experimento. Fica esperto, esse prédio é amaldiçoado."])
