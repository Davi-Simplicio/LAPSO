script = ExtResource("2_w332s")
lines = Array[String](["José: ...", "Camila Ferreira: Esse vizinho nosso, o Paulo... ele era tão fechado, né? Acho que ele se sentia culpado por alguma coisa que o pai dele fez. Ele passava a vida tentando refazer os cálculos do pai. Dizia que 'o passado tinha um erro que precisava ser consertado'. "])
