[resource]
script = ExtResource("1_ccv2b")
lines = Array[String](["Eduarda Faria: Tô esperando pra usar o orelhão do saguão. Exatamente às 16:15, a rádio FM local solta a senha secreta do concurso no ar. É sempre um padrão, cara: eles sempre tocam a 4ª música da fita."])
