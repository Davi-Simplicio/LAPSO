[sub_resource type="Resource" id="Resource_pqv25"]
script = ExtResource("2_wh4ls")
lines = Array[String](["José: Olá", "Sílvia Nogueira: Olá! Você é novo, certo? Ainda bem que apareceu! Que noite louca a de ontem, né? Parecia cena de cinema. Você ouviu o estrondo? Me deu um baita susto. Foi tão dramático.", "José: Mas já descobriram oque aconteceu?", "Sílvia Nogueira: Dizem que o senhor do apartamento 4, o cientista, sumiu! O João Paulo, que é jornalista, está louco com isso. Ele acha que é uma grande reportagem, mas eu acho que é mais como um mistério. Imagina só: um cientista desaparece depois de um clarão. É quase poético, se não fosse tão assustador."])
metadata/_custom_type_script = "uid://bu5dk5m3o7xlm"

