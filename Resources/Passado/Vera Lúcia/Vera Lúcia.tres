[sub_resource type="Resource" id="Resource_c3baj"]
script = ExtResource("2_lby3r")
lines = Array[String](["José: Olá senhora!", "Vera Lúcia: Olá. Não te vi por aqui antes. Que bom que você apareceu. A noite de ontem foi... um evento. O som foi muito alto. A Cláudia diz que o tempo rasgou, eu diria que a física foi desafiada, mas os livros não mentem."])
