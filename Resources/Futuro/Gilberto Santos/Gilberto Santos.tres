[sub_resource type="Resource" id="Resource_bcpxd"]
script = ExtResource("2_f77w5")
lines = Array[String](["Gilberto Santos: Alguém andou mexendo no meu sintetizador de alimentos! Eu estava tentando replicar uma receita antiga de sopa de tomate, mas o tubo de descarte de aminoácidos entupiu. Agora, em vez de sopa, a máquina está expelindo uma espuma rosa fluorescente que não para de crescer! Ela já cobriu o chão da cozinha e está descendo pelas frestas do piso tático para o andar de baixo!"])
metadata/_custom_type_script = "uid://bu5dk5m3o7xlm"

