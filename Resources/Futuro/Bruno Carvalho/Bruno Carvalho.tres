[sub_resource type="Resource" id="Resource_0b3vi"]
script = ExtResource("4_f36yu")
button_label = "Aconteceu algo ontem?"
lines = Array[String](["José: ...", "Bruno Carvalho: Cara, você está perdido? A explosão de ontem foi louca. A gente está acostumado, sabe? O Hugo, que morava no apê 7, tentava consertar uma máquina antiga. Ele dizia que o projeto era do avô e bisavô dele... uma loucura, né? Ele me pediu ajuda com a interface da máquina, para que ela pudesse 'conversar' com diferentes épocas. Mas ele falava que faltava a 'linguagem' certa...\"", "José: Quem é Hugo?", "Bruno Carvalho: Ele era muito ambicioso. Dizia que tinha a chave para consertar a máquina, mas que o problema era entender como conectar os diferentes fragmentos que o avô e o pai dele tinham descoberto..."])
metadata/_custom_type_script = "uid://bu5dk5m3o7xlm"

