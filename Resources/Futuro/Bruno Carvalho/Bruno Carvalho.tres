script = ExtResource("4_f36yu")
button_label = "Aconteceu algo ontem?"
lines = Array[String](["Bruno Carvalho: Ei, você viu o zelador por aí? Os amortecedores hidráulicos das minhas botas magnéticas estouraram. Elas usam um gel de absorção de impacto que é rosa choque. O problema é que o gel vazou todo no duto de ventilação do prédio... se aquilo secar, vai travar as hélices de circulação de ar do condomínio inteiro e todo mundo vai respirar poeira cósmica!"])
