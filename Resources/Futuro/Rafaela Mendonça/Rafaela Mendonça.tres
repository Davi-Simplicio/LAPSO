[sub_resource type="Resource" id="Resource_woi7w"]
script = ExtResource("2_vorcj")
button_label = "Você conhece o Hugo?"
lines = Array[String](["José: ...", "Rafaela Mendonça: O Hugo me procurou uma vez. Ele estava estudando o passado, procurando arquivos dos cientistas da família dele. Ele me disse que o bisavô e o avô tinham a 'lógica', mas faltava a 'memória'. Ele precisava de algo que 'ligasse' o passado ao futuro, algo que a ciência sozinha não podia dar. Ele estava obcecado com as memórias de família."])
metadata/_custom_type_script = "uid://bu5dk5m3o7xlm"

