[sub_resource type="Resource" id="Resource_ma2gw"]
script = ExtResource("2_wh10h")
lines = Array[String](["José: Olá!", "Joaquim Alves: A explosão de ontem foi a mais forte de todas! O Hugo, que sumiu, vivia falando que o grande problema dos antepassados dele era que a máquina não entendia a 'linguagem' da emoção. Por isso que eu tô tentando ensinar emoções para essa IA aqui, saca? Para que ela não cometa os mesmos erros que a gente."])
